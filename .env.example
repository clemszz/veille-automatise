# Copie ce fichier en ".env" (sans .example) et renseigne tes propres valeurs.
# Ne jamais coller ces valeurs ailleurs (chat, code partagé, dépôt git public).

MISTRAL_API_KEY=colle_ta_cle_ici
MISTRAL_MODEL=mistral-large-latest

WEBAPP_PORT=5000

# Optionnel : chemin complet vers un classeur de suivi Excel situé ailleurs
# que dans le dossier de l'application. Par défaut, l'app cherche
# "Veille_marché_ENR.xlsx" à côté de l'exe (ou du dossier parent en mode
# développement) — ne renseigne cette ligne que si tu veux pointer ailleurs.
# TRACKER_XLSX_PATH=C:\chemin\vers\Veille_marché_ENR.xlsx
